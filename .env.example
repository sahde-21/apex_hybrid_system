APP_NAME="Sahdi Create Future"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Release metadata (safe, non-secret identifiers)
APP_VERSION=1.0.0
APP_RELEASE="SCF Enterprise Suite 1.0"
APP_BUILD_ID=
APP_COMMIT_SHA=
APP_RELEASE_DATE=
APP_SCHEMA_VERSION=2026.07

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=scf_erp
DB_USERNAME=scf
DB_PASSWORD=secret

# Local SQLite development: set DB_CONNECTION=sqlite and leave DB_DATABASE empty
# (defaults to database/database.sqlite). Never point tests at that file.
# DB_TEST_DATABASE=:memory:
#
# Destructive commands (migrate:fresh, db:wipe, migrate:refresh/reset/rollback)
# are blocked outside APP_ENV=testing unless this is true. Always run db:backup first.
ALLOW_DESTRUCTIVE_DB=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

# Security headers
SECURITY_HEADERS_ENABLED=true
SECURITY_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API
API_VERSION=v1
API_PER_PAGE=15
API_MAX_PER_PAGE=100
API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
API_TOKEN_EXPIRATION_MINUTES=
API_TOKEN_NAME_PREFIX=api

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=scf_
SANCTUM_TOKEN_EXPIRATION_MINUTES=

# Performance & production readiness
PERFORMANCE_DASHBOARD_CACHE_TTL=120
PERFORMANCE_REFERENCE_CACHE_TTL=3600
PERFORMANCE_DEFAULT_PER_PAGE=15
PERFORMANCE_MAX_PER_PAGE=100
PERFORMANCE_SEARCH_MIN_LENGTH=2
PERFORMANCE_QUEUE_NOTIFICATIONS=true
PERFORMANCE_BACKUP_RETENTION_DAYS=14
PERFORMANCE_HEALTH_EXPOSE_DETAILS=false
PERFORMANCE_INSTRUMENTATION=false
PERFORMANCE_LOG_SLOW_QUERIES=false
PERFORMANCE_SLOW_QUERY_MS=500
LOG_RETENTION_DAYS=14
MAINTENANCE_RETRY_SECONDS=60
# APP_MAINTENANCE_SECRET=
# SECURITY_CSP_REPORT_ONLY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'
PWA_NAME="SCF Enterprise Suite"
PWA_SHORT_NAME=SCF
PWA_DESCRIPTION="Sahdi Create Future — Enterprise Hybrid ERP"
PWA_START_URL=/dashboard
PWA_THEME_COLOR=#020617
PWA_BACKGROUND_COLOR=#020617
PWA_CACHE_VERSION=scf-pwa-v2
